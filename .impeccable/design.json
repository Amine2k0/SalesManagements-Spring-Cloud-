  "narrative": {
    "northStar": "The Duplicate Book",
    "overview": "Carnet is drawn from the carnet à souches, the numbered carbon-copy receipt book kept at shop counters across Morocco. The world appears only through the book's own materials: carbon-blue ink and a carbon-blue cover, white original sheets, the canary and pink of the copy sheets beneath, the red serial a numbering machine prints on every slip, perforated stubs, and the rubber stamp that marks a sale as done. The page structure is an ordinary, legible working app: a navigation rail, sheets of data, standard controls. The world never supplies the layout. It supplies type, palette, density and one signature moment.",
    "keyCharacteristics": [
      "Carbon-blue cover rail and carbon-ink values on white sheets over a cool grey ground.",
      "Red numbering-machine serials (N° 0006) on every sales slip, never on anything else.",
      "Canary copy for the slip being written and for selection; pink copy for low stock.",
      "Flat sheets with hairline rules. Perforated rules mark the stub. Totals get an accountant's double rule.",
      "One typeface (Archivo) across its width axis: semi-condensed caps for labels, normal width for reading."
    ],
    "rules": [
      {
        "name": "The Numbering Machine Rule",
        "body": "Red serials belong to sales slips. Product and customer references stay in tertiary ink, so red always means a slip number or something gone wrong.",
        "section": "colors"
      },
      {
        "name": "The Copy Sheet Rule",
        "body": "Canary means \"being written or just written\"; pink means \"running low\". Neither is decoration.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that can sit in a column (amounts, quantities, dates, counts) uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Printed Label Rule",
        "body": "Labels are printed by the form, so they are small semi-condensed caps. Headings are never uppercase.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "No card shadows and no gradients. A surface is separated by a hairline or a colour field, never by a blur.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set every amount in tabular figures with the DH suffix (7,999.00 DH).",
      "Do keep red for slip serials, destructive actions and errors.",
      "Do use canary for the record being written or just written, and pink only for low stock.",
      "Do separate content with hairline rules (#dfe2ea) on white sheets over the cool ground (#f3f4f7).",
      "Do label fields and columns with the semi-condensed caps label style.",
      "Do keep the stamp as the only authored motion; everything else is instant or a 150ms fade."
    ],
    "donts": [
      "Don't add card shadows, gradients or glass; depth is flat.",
      "Don't build rows of identical stat tiles (caps label over a big number). Totals are a ruled totals line, with the final figure double-ruled.",
      "Don't use a cream or warm paper ground; the ground is cool.",
      "Don't let the receipt-book world supply the layout or controls: no ruled-paper tables, no fake handwriting. Tables, buttons and inputs stay standard.",
      "Don't show a number the API didn't provide."
    ]
  }
}